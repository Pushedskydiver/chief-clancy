{
  "name": "@chief-clancy/root",
  "version": "0.0.0",
  "private": true,
  "description": "Clancy monorepo — autonomous, board-driven development for Claude Code",
  "author": "Alex Clapperton",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint && pnpm lint:css",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint packages/core && publint packages/brief && publint packages/plan && publint packages/scan && publint packages/terminal",
    "attw": "attw --pack packages/core --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/brief --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/plan --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/terminal --ignore-rules cjs-resolves-to-esm no-resolution",
    "version:ci": "changeset version && tsx scripts/group-changelog.ts",
    "prepare": "husky"
  },
  "volta": {
    "node": "24.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "handlebars": "^4.7.9"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
