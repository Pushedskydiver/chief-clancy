{
  "name": "@chief-clancy/root",
  "version": "0.0.0",
  "private": true,
  "description": "Clancy monorepo — autonomous, board-driven development for Claude Code",
  "author": "Alex Clapperton",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint && pnpm lint:css",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint packages/core && publint packages/brief && publint packages/plan && publint packages/scan && publint packages/terminal",
    "attw": "attw --pack packages/core --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/brief --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/plan --ignore-rules cjs-resolves-to-esm no-resolution && attw --pack packages/terminal --ignore-rules cjs-resolves-to-esm no-resolution",
    "version:ci": "changeset version && tsx scripts/group-changelog.ts",
    "prepare": "husky"
  },
  "volta": {
    "node": "24.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "handlebars": "^4.7.9"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^69.0.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.20.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
